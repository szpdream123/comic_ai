# Worker Isolation Configuration
# 启用worker隔离机制，防止本地worker处理线上任务
ENABLE_WORKER_ISOLATION=true

# Worker环境标识（可选，默认根据NODE_ENV自动判断）
# 可选值: production, staging, local
WORKER_ENVIRONMENT=local

# 应用环境
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/comic_ai

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=comic-ai-storage

# Model Gateway
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_PROVIDER_MODEL=seedance-2-0-i2v
VOLCENGINE_ARK_API_KEY=your-api-key-here
# 客易云接口密钥；后台模型配置通过 apiKeyEnv=GLOBAL_AI_OPC_API_KEY 引用。
GLOBAL_AI_OPC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Other configurations...
