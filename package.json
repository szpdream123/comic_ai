{
  "name": "comic-ai",
  "version": "0.2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "package:zip": "powershell -ExecutionPolicy Bypass -File scripts/package-project.ps1",
    "build:production-runtime": "node scripts/build-production-runtime.mjs",
    "start": "node scripts/run-phone-auth-production.mjs",
    "test": "node scripts/run-tests.mjs",
    "build:prompt-editor": "esbuild apps/web/src/features/production-workbench/prompt-editor.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=apps/web/vendor/prompt-editor.js",
    "build:video-depth-encoder": "esbuild apps/web/src/features/toolbox/browser-video-depth-encoder.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=apps/web/src/features/toolbox/browser-video-depth-encoder.bundle.js",
    "build:watermark-removal-runtime": "esbuild apps/web/src/features/toolbox/browser-watermark-removal-runtime.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=apps/web/vendor/watermark-removal-ort.bundle.js",
    "build:video-analysis-decoder": "esbuild apps/web/src/features/toolbox/browser-video-analysis-decoder.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=apps/web/src/features/toolbox/browser-video-analysis-decoder.bundle.js",
    "build:video-pose-runtime": "esbuild apps/web/src/features/toolbox/browser-video-pose-runtime.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=apps/web/src/features/toolbox/browser-video-pose-runtime.bundle.js",
    "build:video-analysis-wasm": "node scripts/build-video-analysis-wasm.mjs",
    "dev": "node scripts/run-creator-dev-stack.mjs",
    "dev:creator": "node scripts/run-creator-dev-stack.mjs",
    "dev:background:start": "node scripts/start-dev-detached.mjs",
    "dev:background:stop": "node scripts/stop-dev-detached.mjs",
    "dev:background:status": "node scripts/status-dev-detached.mjs",
    "dev:http-only:background:start": "node scripts/start-http-only-detached.mjs",
    "dev:http-only:background:stop": "node scripts/stop-http-only-detached.mjs",
    "dev:http-only:background:status": "node scripts/status-http-only-detached.mjs",
    "dev:phone-auth": "node --import tsx scripts/run-phone-auth-dev-server.mjs",
    "dev:http-only": "node scripts/run-phone-auth-http-only.mjs",
    "dev:phone-auth:http-only": "node scripts/run-phone-auth-http-only.mjs",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin-account.mjs",
    "admin:catalog:apply": "node --env-file=.env scripts/apply-membership-catalog.mjs",
    "admin:models:globalaiopc-seedance20:apply": "node --env-file=.env scripts/configure-globalaiopc-seedance20-models.mjs",
    "admin:images:normalize": "node --env-file=.env --import tsx scripts/migrate-admin-images-to-jpeg-png.mjs",
    "db:user-scope:dry-run": "node --env-file=.env scripts/migrate-user-scope.mjs --dry-run",
    "db:user-scope:migrate": "node --env-file=.env scripts/migrate-user-scope.mjs --apply",
    "db:user-scope:data-dry-run": "node --env-file=.env scripts/cleanup-user-scope-data.mjs --dry-run",
    "db:user-scope:data-cleanup": "node --env-file=.env scripts/cleanup-user-scope-data.mjs --apply",
    "db:user-scope:verify-data": "node --env-file=.env scripts/verify-user-centric-data.mjs",
    "db:generation:audit": "node --env-file=.env scripts/audit-generation-pipeline.mjs",
    "db:generation:credits:reconcile": "node --env-file=.env scripts/reconcile-generation-credits.mjs",
    "db:project-covers:backfill": "node --env-file=.env scripts/migrate-user-scope.mjs --apply --only 20260909-backfill-project-cover-storage-objects.sql",
    "db:project-covers:backfill:dry-run": "node --env-file=.env scripts/migrate-user-scope.mjs --dry-run --only 20260909-backfill-project-cover-storage-objects.sql",
    "check:user-scope-zero-refs": "node scripts/check-user-scope-zero-refs.mjs",
    "admin:qa": "node scripts/admin-browser-qa.mjs",
    "test:admin:ui": "node --test apps/admin/index.test.mjs",
    "test:admin:http": "node scripts/run-tests.mjs apps/backend/src/entrypoints/tests/admin-platform-http.spec.ts",
    "test:admin:http:auth": "node scripts/run-tests.mjs apps/backend/src/entrypoints/tests/admin-platform-http.spec.ts -- --test-name-pattern \"admin shell|admin login|sessions|profile|password\"",
    "smoke:text-gateway": "node --import tsx scripts/run-text-model-gateway-smoke.mjs",
    "smoke:canvas-agent": "node --env-file=.env --import tsx scripts/run-canvas-agent-smoke.mjs",
    "legal:generate": "node scripts/generate-third-party-notices.mjs",
    "legal:check": "node scripts/generate-third-party-notices.mjs --check",
    "worker:generation-outbox": "node --import tsx scripts/run-generation-outbox-dispatcher.mjs",
    "worker:generation-repair": "node --import tsx scripts/run-generation-queue-maintenance.mjs",
    "worker:generation-video": "node --import tsx scripts/run-generation-video-worker.mjs",
    "worker:canvas-agent": "node --import tsx scripts/run-canvas-agent-worker.mjs",
    "worker:membership-maintenance": "node --import tsx scripts/run-membership-maintenance.mjs"
  },
  "dependencies": {
    "@antv/x6": "^3.1.7",
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/lib-storage": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@huggingface/transformers": "4.2.0",
    "@mediapipe/tasks-vision": "0.10.17",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "archiver": "^8.0.0",
    "bullmq": "^5.78.0",
    "cos-js-sdk-v5": "^1.8.3",
    "esbuild": "^0.28.1",
    "ioredis": "^5.10.1",
    "lucide-react": "0.468.0",
    "mammoth": "^1.12.0",
    "mediabunny": "1.51.0",
    "openai": "^6.39.1",
    "pdfjs-dist": "^5.4.54",
    "pg": "^8.21.0",
    "qcloud-cos-sts": "^3.1.3",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.3",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
    "three": "^0.184.0",
    "tsx": "^4.22.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/archiver": "^7.0.0",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "axios": "1.18.1",
    "brace-expansion": "5.0.9",
    "form-data": "4.0.6",
    "sharp": "$sharp",
    "tencentcloud-sdk-nodejs-common": {
      "form-data": "3.0.5",
      "uuid": "11.1.1"
    }
  }
}
